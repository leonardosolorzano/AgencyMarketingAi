---
import { nav } from "../data/site";
import Logo from "./Logo.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-ink/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <Logo />
    <nav class="hidden items-center gap-8 text-sm text-mist md:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition-colors hover:text-cream",
            currentPath.startsWith(item.href) && "text-cream",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a
        href="/contacto"
        class="hidden rounded-full bg-lime px-4 py-2 text-sm font-medium text-ink transition hover:bg-cream sm:inline-flex"
      >
        Empezar proyecto
      </a>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-full border border-line md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Menú</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line px-5 py-4 md:hidden" aria-label="Móvil">
    <div class="flex flex-col gap-3 text-base">
      {nav.map((item) => (
        <a href={item.href} class="py-1 text-cream">{item.label}</a>
      ))}
      <a href="/contacto" class="mt-2 rounded-full bg-lime px-4 py-2 text-center text-sm font-medium text-ink">
        Empezar proyecto
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
