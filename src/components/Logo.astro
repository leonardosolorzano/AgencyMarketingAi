---
interface Props {
  class?: string;
  wordmark?: boolean;
}

const { class: className = "", wordmark = true } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label="DevCamp, inicio">
  <span class="relative grid size-10 place-items-center overflow-hidden rounded-2xl bg-lime text-ink shadow-[0_0_0_1px_rgb(214_255_75_/_0.4)]">
    <svg viewBox="0 0 40 40" class="size-7" aria-hidden="true">
      <path d="M8 26 L20 10 L32 26 H8Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"></path>
      <path d="M20 16 L20 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      <circle cx="20" cy="27.5" r="1.6" fill="currentColor"></circle>
    </svg>
  </span>
  {wordmark && (
    <span class="font-display text-[1.35rem] font-semibold tracking-tight">
      Dev<span class="text-lime">Camp</span>
    </span>
  )}
</a>
