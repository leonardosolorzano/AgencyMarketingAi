---
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { cases, faqs, process, services, testimonials } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="DevCamp · Agencia de marketing"
  description="Agencia de marketing digital. Estrategia, performance, contenido, SEO y producto para marcas que quieren crecer con claridad."
>
  <Hero />

  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading
      eyebrow="Servicios"
      title="Un campamento, todo el stack de crecimiento."
      body="No fragmentamos marca, media y producto. Diseñamos un sistema y lo operamos con el mismo criterio."
    />
    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/servicios/${service.slug}`}
          class="group rounded-[1.6rem] border border-line bg-ink-soft p-6 transition hover:border-lime/50"
        >
          <h3 class="font-display text-xl font-semibold">{service.title}</h3>
          <p class="mt-3 text-sm leading-6 text-mist">{service.short}</p>
          <span class="mt-6 inline-flex text-sm text-lime">Ver servicio →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-line bg-ink-soft/50">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <SectionHeading
        eyebrow="Método"
        title="De la niebla al motor."
        body="Cuatro fases. Ritmo de producto. Reporting que se usa para decidir, no para decorar."
      />
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {process.map((item) => (
          <article class="rounded-[1.6rem] border border-line bg-ink p-6">
            <p class="font-display text-lime">{item.step}</p>
            <h3 class="mt-4 text-lg font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-mist">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading eyebrow="Casos" title="Resultados que se pueden leer en un dashboard." />
    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {cases.map((item) => (
        <a href={`/casos/${item.slug}`} class="rounded-[1.6rem] border border-line p-6 hover:border-lime/50">
          <p class="text-xs uppercase tracking-[0.2em] text-mist">{item.client} · {item.sector}</p>
          <h3 class="font-display mt-3 text-2xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-sm text-mist">{item.summary}</p>
          <p class="mt-6 text-lime">{item.result}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-line">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <SectionHeading eyebrow="Clientes" title="Lo que se siente al trabajar con DevCamp." />
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {testimonials.map((item) => (
          <blockquote class="rounded-[1.6rem] border border-line bg-ink-soft p-6">
            <p class="text-base leading-7 text-cream">“{item.quote}”</p>
            <footer class="mt-6 text-sm text-mist">{item.name} · {item.role}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading eyebrow="FAQ" title="Preguntas que llegan antes del primer call." />
    <div class="mt-10 divide-y divide-line border-y border-line">
      {faqs.map((item) => (
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-medium marker:content-none">{item.q}</summary>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-mist">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="px-5 pb-24">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 rounded-[2rem] bg-lime px-8 py-12 text-ink md:flex-row md:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.22em]">Siguiente paso</p>
        <h2 class="font-display mt-2 text-3xl font-semibold">¿Arrancamos el diagnóstico?</h2>
      </div>
      <a href="/contacto" class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream">Hablar con DevCamp</a>
    </div>
  </section>
</BaseLayout>
