---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada · DevCamp" description="Esa ruta no existe en DevCamp.">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-lime">404</p>
    <h1 class="font-display mt-4 text-4xl font-semibold">Te saliste del campamento.</h1>
    <p class="mt-4 text-mist">La página no está. Vuelve al inicio o revisa servicios.</p>
    <a href="/" class="mt-8 inline-flex rounded-full bg-lime px-5 py-3 text-sm font-medium text-ink">Volver a DevCamp</a>
  </section>
</BaseLayout>
