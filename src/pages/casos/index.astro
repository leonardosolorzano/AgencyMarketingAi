---
import SectionHeading from "../../components/SectionHeading.astro";
import { cases } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Casos · DevCamp"
  description="Casos de crecimiento de DevCamp: SaaS, DTC, salud y servicios. Pipeline, CAC y SEO con números."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <SectionHeading
      eyebrow="Casos"
      title="Marcas que dejaron de improvisar."
      body="Una muestra de sistemas que montamos y operamos. Cada caso une estrategia, canales y producto."
    />
    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {cases.map((item) => (
        <a href={`/casos/${item.slug}`} class="rounded-[1.6rem] border border-line p-8 hover:border-lime/50">
          <p class="text-xs uppercase tracking-[0.2em] text-mist">{item.client} · {item.sector}</p>
          <h2 class="font-display mt-4 text-2xl font-semibold">{item.title}</h2>
          <p class="mt-3 text-sm leading-6 text-mist">{item.summary}</p>
          <div class="mt-8 flex gap-6 text-sm">
            <span class="text-lime">{item.result}</span>
            <span class="text-mist">{item.metric}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
