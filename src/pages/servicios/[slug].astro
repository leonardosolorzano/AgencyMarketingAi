---
import SectionHeading from "../../components/SectionHeading.astro";
import { services } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} · DevCamp`} description={service.summary}>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <p class="text-xs uppercase tracking-[0.22em] text-lime">Servicio</p>
    <h1 class="font-display mt-4 text-4xl font-semibold tracking-tight">{service.title}</h1>
    <p class="mt-5 text-lg leading-8 text-mist">{service.summary}</p>
    <div class="mt-12 grid gap-10 sm:grid-cols-2">
      <section>
        <h2 class="text-sm uppercase tracking-[0.2em] text-mist">Qué entregamos</h2>
        <ul class="mt-4 space-y-2 text-cream">
          {service.outcomes.map((item) => <li class="border-b border-line py-2">{item}</li>)}
        </ul>
      </section>
      <section>
        <h2 class="text-sm uppercase tracking-[0.2em] text-mist">Cómo lo hacemos</h2>
        <ol class="mt-4 space-y-2">
          {service.process.map((item, i) => (
            <li class="border-b border-line py-2">
              <span class="text-lime">{String(i + 1).padStart(2, "0")}</span> {item}
            </li>
          ))}
        </ol>
      </section>
    </div>
    <a href="/contacto" class="mt-12 inline-flex rounded-full bg-lime px-5 py-3 text-sm font-medium text-ink">
      Pedir propuesta
    </a>
  </article>
</BaseLayout>
